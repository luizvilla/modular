{
  "name": "@modular/theia-root",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "applications/electron",
    "plugins/modular-dashboard"
  ],
  "scripts": {
    "build:plugin": "npm run build --workspace @modular/modular-dashboard",
    "build:app": "npm run build --workspace @modular/theia-electron-app",
    "build": "npm run build:plugin && npm run build:app",
    "start": "npm run start --workspace @modular/theia-electron-app"
  },
  "overrides": {
    "@vscode/ripgrep": "1.15.14"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.3"
  }
}
