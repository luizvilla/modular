{
  "version": 1,
  "allow_edit": true,
  "plugins": [],
  "panes": [
    {
      "width": 1,
      "row": {
        "3": 1
      },
      "col": {
        "3": 1
      },
      "col_width": 2,
      "widgets": [
        {
          "type": "fast_frame_plot",
          "settings": {
            "title": "Fast Plot",
            "datasource": "MockFast",
            "refreshRate": 150
          }
        }
      ]
    },
    {
      "width": 1,
      "row": {
        "3": 1
      },
      "col": {
        "3": 3
      },
      "col_width": 1,
      "widgets": [
        {
          "type": "fast_frame_control",
          "settings": {
            "datasource": "MockFast",
            "triggerCommand": "TRIGGER",
            "filePath": "fast.csv",
            "autoSave": false,
            "pollMs": 100
          }
        }
      ]
    }
  ],
  "datasources": [
    {
      "name": "MockFast",
      "type": "fast_frame_datasource",
      "settings": {
        "portPath": "COM_MOCK",
        "baudRate": 115200,
        "separator": ":",
        "eol": "\\n",
        "refresh": 100
      }
    }
  ],
  "columns": 3
}
